# ── Scraper ───────────────────────────────────────────────────────────────────
# Set to "true" to use Playwright (handles JavaScript-rendered pages).
# Set to "false" to use plain requests (fast, but may not work on SPAs).
USE_PLAYWRIGHT=true

# Timeout in seconds for the scraper
REQUEST_TIMEOUT=60

# ── Email — choose ONE backend ────────────────────────────────────────────────

# --- Option A: Gmail SMTP (local dev) ---
USE_SES=false
SENDER_EMAIL=your-gmail@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
# Use a Gmail App Password (not your regular password).
# Generate at: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-app-password

# --- Option B: AWS SES (production) ---
# USE_SES=true
# SENDER_EMAIL=alerts@yourdomain.com   # Must be verified in SES
# AWS_REGION=us-east-1

# ── State persistence — choose ONE backend ────────────────────────────────────

# --- Option A: local file (default) ---
USE_S3=false
STATE_FILE=/tmp/seen_jobs.json

# --- Option B: S3 (Lambda / production) ---
# USE_S3=true
# S3_BUCKET=job-alert-bot-state
# S3_KEY=job-alert-bot/seen_jobs.json
# AWS_REGION=us-east-1
